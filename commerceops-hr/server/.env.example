# ---------------------------------------------------------------------------
# You Team — server environment
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public URL of the frontend. Used for CORS and cookie settings.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default points at the bundled embedded PostgreSQL server (`npm run db:start`),
# which needs no system-wide PostgreSQL installation.
#
# To use your own PostgreSQL instead, replace this with your connection string,
# e.g. postgresql://postgres:postgres@localhost:5432/commerceops_hr?schema=public
DATABASE_URL="postgresql://commerceops:commerceops@127.0.0.1:5544/commerceops_hr?schema=public"

# Embedded PostgreSQL settings (only used by `npm run db:start`)
EMBEDDED_PG_PORT=5544
EMBEDDED_PG_USER=commerceops
EMBEDDED_PG_PASSWORD=commerceops
EMBEDDED_PG_DATABASE=commerceops_hr
EMBEDDED_PG_DATA_DIR=.pgdata

# ---------------------------------------------------------------------------
# Auth — CHANGE THESE SECRETS BEFORE DEPLOYING ANYWHERE REAL
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Credentials created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@youteam.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEFAULT_PASSWORD=Welcome@123

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
