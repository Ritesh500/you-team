# ---------------------------------------------------------------------------
# You Team — web environment
# Copy to `.env` (optional: the defaults work with the bundled dev setup).
# ---------------------------------------------------------------------------

# Base URL the browser uses for API calls.
# Left as a relative path, Vite's dev proxy forwards /api to the server, so the
# browser stays single-origin. Set an absolute URL to point at a deployed API.
VITE_API_BASE_URL=/api/v1

# Where Vite's dev proxy forwards /api and /health.
VITE_API_PROXY_TARGET=http://localhost:4000
