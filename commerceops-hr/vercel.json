{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run db:generate --workspace server && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{server/dist/**,node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs" },
    { "source": "/health", "destination": "/api/index.mjs" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
